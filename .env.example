# ================================================================================
# Planka Configuration
# ================================================================================

# --- Planka URL ------------------------------------------------------------------
PLANKA_BASE_URL=https://planka.example.com

# --- Agent (LLM) Credentials -----------------------------------------------------
# Provide EITHER an API key OR the email/password pair below.
PLANKA_AGENT_EMAIL=agent@example.com
PLANKA_AGENT_PASSWORD=your_password_here

# --- API Key (alternative to email/password) -------------------------------------
# Per-user Planka API key, sent in the `X-Api-Key` header.
# Required when the instance runs with OIDC_ENFORCED=true (email/password login is
# disabled then). When set, PLANKA_AGENT_PASSWORD is not needed; you may still keep
# PLANKA_AGENT_EMAIL so the admin-user lookup can resolve the acting user's ID.
# PLANKA_API_KEY=your_planka_api_key_here

# --- Admin (optional, for specific operations) ------------------------------------
# You may optionally specify either Email or ID (not required, choose one if needed)
PLANKA_ADMIN_EMAIL=admin@example.com
# PLANKA_ADMIN_ID=0000000000000000000

# --- Connection Settings ----------------------------------------------------------
PLANKA_IGNORE_SSL=true

# --- HTTP mode (multi-user, behind an authentication gateway) ---------------------
# MCP_TRANSPORT=http
# HTTP_HOST=0.0.0.0
# HTTP_PORT=8000
# Header carrying each caller's own Planka API key, set by the gateway.
# PLANKA_API_KEY and the agent email/password are ignored in this mode.
# MCP_API_KEY_HEADER=X-Planka-Api-Key
